{
  "name": "vscode-ai-orchestration",
  "displayName": "AI Orchestration & Task Manager",
  "description": "Task backlog management, worktree execution control, and multi-agent independent verification for Kilo, Claude, and Codex.",
  "version": "0.2.7",
  "publisher": "AlfredoOliviero",
  "license": "MIT",
  "icon": "resources/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/primax79/vscode-ai-orchestration.git"
  },
  "engines": {
    "vscode": "^1.85.0",
    "node": ">=18.0.0"
  },
  "categories": [
    "Programming Languages",
    "AI",
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onCommand:aiOrchestration.openDashboard",
    "onCommand:aiOrchestration.openDecision",
    "onCommand:aiOrchestration.openDecisions",
    "onView:aiOrchestration.nextUpView",
    "onView:aiOrchestration.decisionsView"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "ai-orchestration-sidebar",
          "title": "AI Orchestration",
          "icon": "resources/icon.svg"
        }
      ]
    },
    "views": {
      "ai-orchestration-sidebar": [
        {
          "id": "aiOrchestration.nextUpView",
          "name": "Next Up",
          "contextualTitle": "Next Up Focus Queue"
        },
        {
          "id": "aiOrchestration.initiativesView",
          "name": "Initiatives",
          "contextualTitle": "Planned Initiatives"
        },
        {
          "id": "aiOrchestration.decisionsView",
          "name": "Decisions Waiting",
          "contextualTitle": "Decisions Waiting on User"
        }
      ]
    },
    "commands": [
      {
        "command": "aiOrchestration.openDashboard",
        "title": "Open Task Dashboard",
        "category": "AI Orchestration",
        "icon": "$(layers)"
      },
      {
        "command": "aiOrchestration.openDecision",
        "title": "Open Decision in Dashboard",
        "category": "AI Orchestration",
        "icon": "$(question)"
      },
      {
        "command": "aiOrchestration.openDecisions",
        "title": "Open Decisions in Dashboard",
        "category": "AI Orchestration",
        "icon": "$(question)"
      },
      {
        "command": "aiOrchestration.refresh",
        "title": "Refresh Tasks",
        "category": "AI Orchestration",
        "icon": "$(refresh)"
      },
      {
        "command": "aiOrchestration.syncIndex",
        "title": "Sync 00-INDEX.md",
        "category": "AI Orchestration",
        "icon": "$(file-check)"
      },
      {
        "command": "aiOrchestration.validateTasks",
        "title": "Validate Tasks",
        "category": "AI Orchestration",
        "icon": "$(check-all)"
      },
      {
        "command": "aiOrchestration.copyHandoff",
        "title": "Copy Handoff Prompt",
        "category": "AI Orchestration",
        "icon": "$(copy)"
      },
      {
        "command": "aiOrchestration.openTaskFile",
        "title": "Open Task File",
        "category": "AI Orchestration",
        "icon": "$(go-to-file)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "aiOrchestration.openDashboard",
          "when": "view =~ /^aiOrchestration\\./",
          "group": "navigation@1"
        },
        {
          "command": "aiOrchestration.syncIndex",
          "when": "view =~ /^aiOrchestration\\./",
          "group": "navigation@2"
        },
        {
          "command": "aiOrchestration.refresh",
          "when": "view =~ /^aiOrchestration\\./",
          "group": "navigation@3"
        }
      ],
      "view/item/context": [
        {
          "command": "aiOrchestration.copyHandoff",
          "when": "viewItem == taskItem",
          "group": "inline@1"
        },
        {
          "command": "aiOrchestration.openTaskFile",
          "when": "viewItem == taskItem",
          "group": "inline@2"
        }
      ]
    },
    "configuration": {
      "title": "AI Orchestration",
      "properties": {
        "aiOrchestration.cliPath": {
          "type": "string",
          "default": "",
          "description": "Custom path to the ai-orch CLI executable. Leave empty to auto-detect."
        },
        "aiOrchestration.autoSyncOnSave": {
          "type": "boolean",
          "default": true,
          "description": "Automatically synchronize 00-INDEX.md when a task file under tasks/ is saved."
        },
        "aiOrchestration.notifyNewQuestions": {
          "type": "boolean",
          "default": true,
          "description": "Show notification toasts when new blocking decisions arrive."
        }
      }
    }
  },
  "scripts": {
    "build": "node esbuild.config.mjs",
    "watch": "node esbuild.config.mjs --watch",
    "compile": "tsc -p . --noEmit && node esbuild.config.mjs",
    "vscode:prepublish": "npm run compile",
    "sync-webview": "node scripts/sync-webview.mjs",
    "test": "node scripts/test-bridge-parity.mjs && node scripts/test-decisions-tree.mjs && node scripts/test-question-notifier.mjs && node scripts/test-cli-guard.mjs && node scripts/test-refresh-loop.mjs && node scripts/test-task-detail.mjs"
  },
  "devDependencies": {
    "@types/node": "^20.17.0",
    "@types/vscode": "^1.85.0",
    "esbuild": "^0.24.2",
    "typescript": "^5.7.3"
  }
}
